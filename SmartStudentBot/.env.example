# ==============================================================================
#                    تنظیمات محیطی پروژه SmartStudentBot (Perugia)
# ==============================================================================

# ۱. تنظیمات تلگرام (ضروری)
# توکن دریافتی از @BotFather در تلگرام
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# شناسه عددی ادمین‌ها در تلگرام (جدا شده با کاما) - برای دریافت هشدارها و مدیریت
ADMIN_CHAT_IDS=123456789

# شناسه یکتای ربات
BOT_ID=perugia

# رمز امنیتی وب‌هوک (در حالت لوکال نیازی نیست)
WEBHOOK_SECRET=mysecretkey123

# آیدی کانال اطلاع‌رسانی (اختیاری)
CHANNEL_ID=@perugia_students

# ۲. حالت اجرا و سرور
# برای اجرای لوکال با Polling مقدار development و برای سرور با Webhook مقدار production بگذارید
ENVIRONMENT=development
BASE_URL=http://localhost:8000
PORT=8000
DEBUG=True

# ۳. تنظیمات پایگاه داده
# در صورت اجرای داکر: mongodb://mongo:27017/
# در صورت اجرای مستقیم روی ویندوز (در صورت نصب مونگو): mongodb://localhost:27017/
MONGO_URI=mongodb://mongo:27017/
REDIS_URL=redis://redis:6379

# ۴. کلیدهای هوش مصنوعی (AI)
# کلید رایگان جمینای گوگل از آدرس: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# کلید OpenRouter (اختیاری)
OPENROUTER_API_KEY=

# ۵. کلیدهای سرویس‌های جانبی
# کلید آب‌وهوای OpenWeather (اختیاری است؛ در صورت خالی بودن، ربات به طور خودکار و رایگان از Open-Meteo اروپا استفاده می‌کند)
OPENWEATHERMAP_API_KEY=

# نرخ ارز بازار آزاد (کلیدهای پیش‌فرض در کد تعریف شده، اما می‌توانید اختصاصی قرار دهید)
NAVASAN_API_KEYS=
